243: // This is called during InitGenesis when block time is available.
244: // It validates that LastSettledAt timestamps are not in the future relative to block time.
245: func (gs *GenesisState) ValidateWithBlockTime(blockTime time.Time) error {
246:    for _, lease := range gs.Leases {
247:            // Validate LastSettledAt is not in the future
248:            if lease.LastSettledAt.After(blockTime) {
249:                    return ErrInvalidLease.Wrapf(
250:                            "lease %s has last_settled_at (%s) in the future relative to block time (%s)",
251:                            lease.Uuid,
252:                            lease.LastSettledAt.String(),
253:                            blockTime.String(),
254:                    )
255:            }
256:
257:            // Validate CreatedAt is not in the future
258:            if lease.CreatedAt.After(blockTime) {
259:                    return ErrInvalidLease.Wrapf(
260:                            "lease %s has created_at (%s) in the future relative to block time (%s)",
261:                            lease.Uuid,
262:                            lease.CreatedAt.String(),
263:                            blockTime.String(),
264:                    )
265:            }
266:
267:            // For inactive leases, validate ClosedAt is not in the future
268:            if lease.State == LEASE_STATE_CLOSED && lease.ClosedAt != nil {
269:                    if lease.ClosedAt.After(blockTime) {
270:                            return ErrInvalidLease.Wrapf(
271:                                    "lease %s has closed_at (%s) in the future relative to block time (%s)",
272:                                    lease.Uuid,
273:                                    lease.ClosedAt.String(),
274:                                    blockTime.String(),
275:                            )
276:                    }
277:            }

