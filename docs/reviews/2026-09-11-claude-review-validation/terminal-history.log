525:
526:                    // ShouldAutoCloseLease uses a GTE boundary (accrued >= balance), so it
527:                    // also fires when the tenant's credit EXACTLY covers the accrued
528:                    // charges — and in a batch an earlier lease's settlement can drain the
529:                    // shared credit balance so a later, fully-paid lease trips the boundary
530:                    // with nothing left unpaid. That is a full payment (the credit did its
531:                    // job), not exhaustion, so the caller-supplied reason and role are
532:                    // preserved (ENG-577).
533:                    //
534:                    // Keep the caller's reason ONLY when a positive accrued charge was
535:                    // settled in full. Everything else ShouldAutoCloseLease flags is genuine
536:                    // exhaustion and keeps the credit_exhausted label:
537:                    //   - overflow: PerformSettlementSilent clamps AccruedAmounts to the
538:                    //     remaining balance and transfers it all, so `unpaid` reads zero;
539:                    //     detect it via the same duration threshold the accrual layer uses.
540:                    //   - partial settlement: the transfer fell short of the accrued amount.
541:                    //   - zero-balance / zero-duration: a required denom balance is already
542:                    //     zero with nothing accrued this instant (AccruedAmounts empty) — the
543:                    //     credit is exhausted even though there is no unpaid remainder.
544:                    overflowed := int64(duration/time.Second) > MaxDurationSeconds
545:                    unpaid := result.AccruedAmounts.Sub(result.TransferAmounts...)
546:                    if overflowed || !unpaid.IsZero() || result.AccruedAmounts.IsZero() {
547:                            leases[i].ClosureReason = types.ClosureReasonCreditExhausted
548:                            leaseClosedBy = "credit_exhaustion"
549:                    } else {
550:                            leases[i].ClosureReason = msg.Reason
551:                    }
552:            } else {
553:                    // Normal close - use block time
554:                    closeTime = blockTime
