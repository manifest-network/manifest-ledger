840: // It settles the lease, updates its state to CLOSED, decrements the active lease count,
841: // and releases the reservation. All changes are applied to the provided context.
842: // The caller is responsible for CacheContext management and event emission.
843: func (k *Keeper) AutoCloseLease(ctx context.Context, lease *types.Lease, closeTime time.Time, minLeaseDuration uint64) (*AutoCloseLeaseResult, error) {
844:    result, err := k.PerformSettlementSilent(ctx, lease, closeTime)
845:    if err != nil {
846:            return nil, err
847:    }
848:
849:    lease.State = types.LEASE_STATE_CLOSED
850:    lease.ClosedAt = &closeTime
851:    lease.LastSettledAt = closeTime
852:    lease.ClosureReason = types.ClosureReasonCreditExhausted
853:
854:    if err := k.SetLease(ctx, *lease); err != nil {
855:            return nil, err
856:    }
857:
858:    creditAccount, err := k.GetCreditAccount(ctx, lease.Tenant)
859:    if err != nil {
860:            return nil, err
861:    }
862:
863:    k.DecrementActiveLeaseCount(&creditAccount, lease.Uuid)
864:    k.ReleaseLeaseReservation(&creditAccount, lease, minLeaseDuration)
865:
866:    if err := k.SetCreditAccount(ctx, creditAccount); err != nil {
867:            return nil, err
868:    }

