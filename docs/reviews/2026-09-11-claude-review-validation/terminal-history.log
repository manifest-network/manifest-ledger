1083: // settleLease calculates and transfers accrued charges from tenant's credit account
1084: // to the provider's payout address. Returns the amounts settled (one per denom).
1085: func (ms msgServer) settleLease(ctx context.Context, lease *types.Lease, settleTime time.Time) (sdk.Coins, error) {
1086:   result, err := ms.k.PerformSettlement(ctx, lease, settleTime)
1087:   if err != nil {
1088:           return sdk.NewCoins(), err
1089:   }
1090:
1091:   // Update last_settled_at
1092:   lease.LastSettledAt = settleTime
1093:
1094:   return result.TransferAmounts, nil
1095: }
