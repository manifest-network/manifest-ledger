920: func (app *BaseApp) Commit() (*abci.ResponseCommit, error) {
921:    header := app.finalizeBlockState.Context().BlockHeader()
922:    retainHeight := app.GetBlockRetentionHeight(header.Height)
923:
924:    if app.precommiter != nil {
925:        app.precommiter(app.finalizeBlockState.Context())
926:    }
927:
928:    rms, ok := app.cms.(*rootmulti.Store)
929:    if ok {
930:        rms.SetCommitHeader(header)
931:    }
932:
933:    app.cms.Commit()
934:
935:    resp := &abci.ResponseCommit{
936:        RetainHeight: retainHeight,
937:    }
938:
939:    abciListeners := app.streamingManager.ABCIListeners
940:    if len(abciListeners) > 0 {
941:        ctx := app.finalizeBlockState.Context()
942:        blockHeight := ctx.BlockHeight()
943:        changeSet := app.cms.PopStateCache()
944:
945:        for _, abciListener := range abciListeners {
946:            if err := abciListener.ListenCommit(ctx, *resp, changeSet); err != nil {
947:                app.logger.Error("Commit listening hook failed", "height", blockHeight, "err", err)
948:            }
949:        }
950:    }
951:
952:    // Reset the CheckTx state to the latest committed.
953:    //
954:    // NOTE: This is safe because CometBFT holds a lock on the mempool for
955:    // Commit. Use the header from this latest block.
956:    app.setState(execModeCheck, header)
957:
958:    app.finalizeBlockState = nil

