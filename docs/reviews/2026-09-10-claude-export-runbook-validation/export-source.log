50:     // or processing the first block or not.
51:     app.initialHeight = req.InitialHeight
52:     if app.initialHeight == 0 { // If initial height is 0, set it to 1
53:         app.initialHeight = 1
54:     }
55:
56:     // if req.InitialHeight is > 1, then we set the initial version on all stores
57:     if req.InitialHeight > 1 {
58:         initHeader.Height = req.InitialHeight
59:         if err := app.cms.SetInitialVersion(req.InitialHeight); err != nil {
60:             return nil, err
61:         }
62:     }
63:
64:     // initialize states with a correct header
65:     app.setState(execModeFinalize, initHeader)
66:     app.setState(execModeCheck, initHeader)

