40:     if req.ChainId != app.chainID {
41:         return nil, fmt.Errorf("invalid chain-id on InitChain; expected: %s, got: %s", app.chainID, req.ChainId)
42:     }
43:
44:     // On a new chain, we consider the init chain block height as 0, even though
45:     // req.InitialHeight is 1 by default.
46:     initHeader := cmtproto.Header{ChainID: req.ChainId, Time: req.Time}
